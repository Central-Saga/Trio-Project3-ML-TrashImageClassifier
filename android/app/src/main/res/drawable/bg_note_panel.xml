<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fokus aktif -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_input" />
            <stroke
                android:width="2dp"
                android:color="@color/accent_teal" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Kursor mouse diarahkan ke input -->
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_input" />
            <stroke
                android:width="1dp"
                android:color="@color/border_teal" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Tampilan normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_input" />
            <stroke
                android:width="1dp"
                android:color="@color/border_input" />
            <corners android:radius="16dp" />
        </shape>
    </item>

</selector>